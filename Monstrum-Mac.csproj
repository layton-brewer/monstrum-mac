<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Monstrum-Mac</AssemblyName>
    <RootNamespace>MonstrumMac</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- No debug info, so the DLL carries no build-machine paths. -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.ParticleSystemModule.dll" Private="false" />
  </ItemGroup>
</Project>
